# Brett livetest på Raspberry Pi:n: följer många spelare framåt, inga order.
[Unit]
Description=Mimic brett livetest (5 767 spelare, bara kedjan)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@HOME@/mimic
ExecStart=@HOME@/mimic/.venv/bin/python scripts/pm_livetest.py run @HOME@/pm_bred --db none
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
