# Livetest på Raspberry Pi:n, som användartjänst (systemctl --user). Bara läsning.
[Unit]
Description=Mimic livetest (Polymarket, blockkedjan)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=@HOME@/mimic
ExecStart=@HOME@/mimic/.venv/bin/python scripts/pm_livetest.py run @HOME@/pm_livetest --db @HOME@/mimic/seed.db
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
