# Livetest (fas 6) som systemd-tjänst på VM:en. Bara läsning, ingen handel.
# Installera:
#   sudo cp deploy/mimic-live.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mimic-live
# Följ loggen: journalctl -u mimic-live -f
[Unit]
Description=Mimic livetest (pappershandel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mimic
WorkingDirectory=/opt/mimic
ExecStart=/opt/mimic/.venv/bin/mimic live
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
